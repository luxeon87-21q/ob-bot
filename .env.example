# Скопируйте этот файл в .env и заполните

# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Ваш chat_id (узнать: напишите боту /start, затем  python3 bot.py --chat-id)
# Можно указать id группы/канала — бот должен быть там админом
TELEGRAM_CHAT_ID=

# Какие акции: sp500, nasdaq100, file (свой список в tickers.txt) — через запятую
UNIVERSE=sp500,nasdaq100

# Настройки индикатора (как в LuxAlgo)
OB_LENGTH=5            # длина internal-структуры (swing — 50, как в индикаторе)
OB_MITIGATION=Wick     # Wick (= High/Low в индикаторе) или Close
OB_TRACK_LAST=5        # сколько последних OB каждого вида (internal / swing) видно и отслеживается (0 = все непробитые)

# Какие сигналы присылать
NOTIFY_FORMED=true     # сформирован новый ордер-блок
NOTIFY_TOUCHED=true    # цена коснулась ордер-блока
NOTIFY_MITIGATED=false # ордер-блок пробит
ONLY_NEW=false         # true = присылать только новые ордер-блоки (перекрывает три строки выше)

# Через сколько минут после закрытия 4H свечи проверять (Yahoo отдаёт данные с задержкой)
CHECK_DELAY_MIN=10

# Веб-версия (python3 web.py)
WEB_HOST=127.0.0.1     # 0.0.0.0 — открыть с телефона / других устройств (обязательно задайте пароль)
WEB_PORT=8000
WEB_PASSWORD=          # пароль для входа на сайт (логин любой)

# Волны Вульфа (отдельная функция)
WOLFE=true
WOLFE_PIVOT=4           # свечей с каждой стороны для точки разворота

# Сезонность (seasonal.py, по понедельникам и пятницам) — всё необязательно, ниже значения по умолчанию
SEAS_MOVE=10            # цель: ход не меньше, %
SEAS_ADVERSE=5          # стоп: насколько цена может уйти против нас до достижения цели, %
SEAS_MIN_DAYS=20        # окно от ... календарных дней
SEAS_MAX_DAYS=90        # ... до
SEAS_WIN_MIN=0.8        # цель достигалась минимум в 80% лет
SEAS_MIN_YEARS=10       # минимум лет истории
SEAS_MAX_YEARS=20       # учитывать последние N лет
SEAS_P_MAX=0.01         # максимальный «шанс случайности»
SEAS_OI_MIN=5000        # открытый интерес опционов (коллы+путы, экспирации ≤30 дней)
SEAS_MIN_DVOL=5000000   # средний дневной оборот, $ (предварительный отсев)

# MA200: ложный пробой и отскок (ma200.py, по будням) — всё необязательно, ниже значения по умолчанию
MA200_N=3               # прокол — на одной из N свечей перед сигнальной
MA200_DEPTH_ATR=1.0     # минимум свечи прокола не глубже MA − 1 ATR
MA200_CLOSE_ATR=0.3     # закрытие свечи прокола выше MA − 0,3 ATR
MA200_OI_MIN=1000       # открытый интерес опционов (0 — без фильтра)
MA200_MIN_DVOL=5000000  # средний дневной оборот, $
