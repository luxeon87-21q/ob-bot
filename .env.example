# Скопируйте этот файл в .env и заполните

# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Ваш chat_id (узнать: напишите боту /start, затем  python3 bot.py --chat-id)
# Можно указать id группы/канала — бот должен быть там админом
TELEGRAM_CHAT_ID=

# Какие акции: sp500, nasdaq100, file (свой список в tickers.txt) — через запятую
UNIVERSE=sp500,nasdaq100

# Настройки индикатора (как в LuxAlgo)
OB_LENGTH=5            # Volume Pivot Length
OB_MITIGATION=Wick     # Wick или Close
OB_TRACK_LAST=3        # сколько последних OB каждой стороны отслеживать на касание (0 = все непробитые)

# Какие сигналы присылать
NOTIFY_FORMED=true     # сформирован новый ордер-блок
NOTIFY_TOUCHED=true    # цена коснулась ордер-блока
NOTIFY_MITIGATED=false # ордер-блок пробит
ONLY_NEW=false         # true = присылать только новые ордер-блоки (перекрывает три строки выше)

# Через сколько минут после закрытия 4H свечи проверять (Yahoo отдаёт данные с задержкой)
CHECK_DELAY_MIN=10

# Веб-версия (python3 web.py)
WEB_HOST=127.0.0.1     # 0.0.0.0 — открыть с телефона / других устройств (обязательно задайте пароль)
WEB_PORT=8000
WEB_PASSWORD=          # пароль для входа на сайт (логин любой)
